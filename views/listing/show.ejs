<% layout("/layouts/boilerplate") %>

    <body>

        <div class="show card" style="width: 98vw;">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="image">
            <div class="card-body">
                <h3 class="card-title">
                    <%= listing.title %>
                </h3>
                <h5 class="card-location">
                    <%= listing.location %>,<%= listing.country %>
                </h5>
                <h3 class="card-price">&#8377 <%= listing.price.toLocaleString("en-IN") %>
                </h3>
                <p class="card-text">
                    <%= listing.description %>
                </p>

                <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
                    <a href="/listings/<%=listing._id%>/edit" class="btn btn-primary">Edit</a>
                    <br>
                    <br>
                    <form method="post" action="/listings/<%=listing._id%>?_method=DELETE"><button
                            class="btn btn-danger" type="submit">Delete</button></form>
                    <% } %>

                        <% if(currUser) { %>
                            <hr>
                            <h5>Reviews</h5>
                            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate
                                class="needs-validation">
                                <div class="mt-3">



                                    <label for="ratings" class="form-label">Rating</label>

                                    <fieldset class="starability-slot">
                                        <input type="radio" id="no-rate" class="input-no-rate" name="review[ratings]"
                                            value="1" checked aria-label="No rating." />
                                        <input type="radio" id="first-rate1" name="review[ratings]" value="1" />
                                        <label for="first-rate1" title="Terrible">1 star</label>
                                        <input type="radio" id="first-rate2" name="review[ratings]" value="2" />
                                        <label for="first-rate2" title="Not good">2 stars</label>
                                        <input type="radio" id="first-rate3" name="review[ratings]" value="3" />
                                        <label for="first-rate3" title="Average">3 stars</label>
                                        <input type="radio" id="first-rate4" name="review[ratings]" value="4" />
                                        <label for="first-rate4" title="Very good">4 stars</label>
                                        <input type="radio" id="first-rate5" name="review[ratings]" value="5" />
                                        <label for="first-rate5" title="Amazing">5 stars</label>
                                    </fieldset>
                                </div>

                                <div class="mt-3 mb-3">
                                    <h6>Write something about this place</h6>
                                    <label for="comment" class="form-label"></label>
                                    <textarea name="review[comment]" id="comment" rows="10" class="form-control"
                                        required></textarea>
                                    <div class="invalid-feedback">please add some review</div>
                                </div>
                                <button class="btn btn-success" type="submit">Add Review</button>
                            </form>
                            <% } %>

                                <hr>
                                <br>
                                <p><b>All Reviews</b></p>
                                <div class="row">

                                    <% for(review of listing.reviews){ %>
                                        <div class="card col-md-4 mb-3 ms-3" style="width: 18rem;">
                                            <div class="card-body">
                                                <h5 class="card-title">user</h5>
                                                <h6 class="card-subtitle mb-2 text-body-secondary">
                                                    &#9679; <%= review.author.username %>

                                                        <p class="starability-result" data-rating="<%=review.ratings%>">
                                                            Rated: <%= review.ratings %> stars
                                                        </p>
                                                </h6>
                                                <p class="card-text">
                                                    <%= review.comment %>
                                                </p>

                                                <% if(currUser && review.author._id.equals(currUser._id)) { %>


                                                    <form class="mb-3" method="post"
                                                        action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                                                        <button class="btn btn-danger btn-sm"
                                                            type="submit">Delete</button>
                                                    </form>

                                                    <% } %>
                                            </div>

                                        </div>

                                        <% } %>

                                </div>

            </div>

        </div>
        <div class="map-container">
            <h3>Location:</h3>

            <div id="map" data-latitude="<%= listing.latitude %>" data-longitude="<%= listing.longitude %>"
                data-map-token="<%= process.env.MAP_TOKEN %>" data-title="<%= listing.title %>">
            </div>


            <script src="/js/map.js"></script>
        </div>
        </div>

    </body>